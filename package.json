{
  "name": "cocoaconvert",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fast, private file conversion in the browser, with an optional server for office and archive formats.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build && vitest run --config vitest.e2e.config.ts",
    "fixtures": "bash scripts/make-fixtures.sh",
    "docs:formats": "tsx scripts/list-formats.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "7zip-bin": "^5.2.0",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "js-yaml": "^5.5.0",
    "libheif-js": "^1.23.5",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0",
    "turndown": "^7.2.5",
    "utif2": "^4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
